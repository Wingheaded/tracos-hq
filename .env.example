# Copy to .env.local and fill in. Never commit .env.local.

# xAI (console.x.ai -> API Keys)
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Pipedrive (Settings -> Personal preferences -> API). Domain is the name before .pipedrive.com
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=

# true = use the saved lead results in kit/leads/ instead of a live web search
LEADS_FALLBACK=false
